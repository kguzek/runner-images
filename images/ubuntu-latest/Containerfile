# this SHA corresponds to tags: 26.04, resolute, latest
FROM docker.io/ubuntu@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b AS base

ARG PROJECT_NAME
ARG REPOSITORY_NAME
ARG GIT_HOSTNAME
ARG GIT_OWNER
ARG IMAGE_CREATED
ARG IMAGE_VERSION
ARG IMAGE_REVISION
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.created="${IMAGE_CREATED}"
LABEL org.opencontainers.image.authors="Konrad Guzek"
LABEL org.opencontainers.image.url="https://${GIT_HOSTNAME}/${GIT_OWNER}/-/packages/container/${PROJECT_NAME}%2F${REPOSITORY_NAME}"
LABEL org.opencontainers.image.documentation="https://${GIT_HOSTNAME}/${GIT_OWNER}/${PROJECT_NAME}/src/branch/main/README.md"
LABEL org.opencontainers.image.source="https://${GIT_HOSTNAME}/${GIT_OWNER}/${PROJECT_NAME}"
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"
LABEL org.opencontainers.image.revision="${IMAGE_REVISION}"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="A generic runner OCI image for use by Forgejo Actions"
LABEL org.opencontainers.image.description="Built to balance compatibility with GitHub Actions' `ubuntu-latest` against low image size."

# `gettext-base` is used for `envsubst`: https://git.guzek.uk/kguzek/liveseries-server/actions/runs/3/jobs/0/attempt/1
RUN apt-get update && apt-get install --yes \
  ca-certificates \
  curl \
  wget \
  zip \
  unzip \
  tar \
  jq \
  git \
  gettext-base \
  rustup
RUN apt-get install --yes gcc
RUN apt-get install --yes nodejs build-essential
# RUN apt-get install --yes npm

# setup Docker apt repository: https://docs.docker.com/engine/install/ubuntu/#install-using-the-repository
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
  chmod a+r /etc/apt/keyrings/docker.asc && \
  cat > /etc/apt/sources.list.d/docker.sources <<EOF && apt-get update
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

# install docker packages
RUN apt-get install --yes --no-install-recommends docker-ce
RUN apt-get install --yes \
  docker-ce-cli \
  containerd.io \
  docker-buildx-plugin \
  docker-compose-plugin \
  skopeo

FROM base AS android-command-line-tools

ARG ANDROID_CMDLINE_TOOLS_BUILD=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583

RUN curl --fail --silent --show-error --location \
    "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_BUILD}_latest.zip" \
    --output /tmp/android-command-line-tools.zip && \
  echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-command-line-tools.zip" | sha256sum --check && \
  unzip -q /tmp/android-command-line-tools.zip -d /tmp/android && \
  mv /tmp/android/cmdline-tools/lib/external/lint-psi /tmp/lint-psi && \
  rm /tmp/android-command-line-tools.zip

FROM base

ENV ANDROID_HOME=/usr/local/lib/android/sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=${ANDROID_HOME}/cmdline-tools/latest/bin:${CARGO_HOME}/bin:${PATH}

# keep layers below 100 MB
COPY --from=android-command-line-tools /tmp/android/cmdline-tools/ ${ANDROID_HOME}/cmdline-tools/latest/
COPY --from=android-command-line-tools /tmp/lint-psi/ ${ANDROID_HOME}/cmdline-tools/latest/lib/external/lint-psi/
